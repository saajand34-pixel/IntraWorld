rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔒 Allow registration page to read the secret Gemini API key
    match /system_config/{doc} {
      allow read: if true;
      allow write: if false; // Only you can edit from Firebase Console
    }

    // 👤 User profiles and student records
    match /users/{userId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }
  }
}